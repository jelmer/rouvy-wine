# ROUVY on Linux with patched Wine, in a container.
#
# This stage is quick: it pulls the current ROUVY installer and bakes it
# into a fresh Wine prefix on top of the wine-base image. Rebuild this
# layer whenever a new ROUVY installer is out; see README.md.
#
# Build:  podman build -f container/Containerfile -t ghcr.io/jelmer/rouvy .
# Run:    see run-rouvy.sh in the repo root
#
# All user data (prefix, login, settings, downloaded routes) lives under
# /data, which must be mounted from a volume.

ARG WINE_BASE=ghcr.io/jelmer/rouvy-wine-base:latest
FROM ${WINE_BASE}

# Install ROUVY into a template prefix. NSIS /S doesn't need a display, so
# the installer runs headless. wineboot primes the prefix first.
COPY container/download-rouvy.sh /build/
RUN /build/download-rouvy.sh /build \
 && mkdir -p /tmp/xdg && chmod 700 /tmp/xdg \
 && export WINEPREFIX=/opt/rouvy-prefix WINEDEBUG=-all XDG_RUNTIME_DIR=/tmp/xdg \
 && /opt/wine-overlay/bin/wineboot --init \
 && /opt/wine-overlay/bin/wineserver -w \
 && /opt/wine-overlay/bin/wine /build/Rouvy_Installer*.exe /S \
 && /opt/wine-overlay/bin/wineserver -w \
 && rm -f /build/Rouvy_Installer*.exe

COPY container/container-entrypoint.sh /usr/local/bin/rouvy
RUN chmod +x /usr/local/bin/rouvy

VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/rouvy"]
